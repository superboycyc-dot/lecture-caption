{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acknowledged"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "acknowledged": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "revision"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
